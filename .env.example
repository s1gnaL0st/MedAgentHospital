# LLM backend: deepseek / openai / rule
LLM_BACKEND=deepseek

# DeepSeek API
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenAI-compatible server, e.g. vLLM serving HuatuoGPT-II-7B on the 3090
HUATUO_BASE_URL=http://<server-ip>:8000/v1
HUATUO_MODEL=huatuo

# Project settings
SEED=42
