# LLM backend: deepseek / openai / rule
LLM_BACKEND=deepseek

# DeepSeek API
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenAI-compatible server, e.g. vLLM serving HuatuoGPT-II-7B on the 3090
HUATUO_BASE_URL=http://<server-ip>:8000/v1
HUATUO_MODEL=huatuo

# Optional PostgreSQL backend. Leave empty to use local SQLite.
# DATABASE_URL=postgresql://medagent:medagent@127.0.0.1:5432/medagent
# REDIS_URL=redis://127.0.0.1:6379/0

# Project settings
SEED=42
